# NestJS API configuration — copy to .env and adjust
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/aimanthan
CORS_ORIGINS=http://localhost:3000

# Admin APIs (queue, coordinators CRUD) — x-admin-key header
ADMIN_KEY=change-me-long-random-string

# Coordinator email dispatch (SMTP) — leave empty to log-only
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AI Manthan Support <support@aimanthan.in>
