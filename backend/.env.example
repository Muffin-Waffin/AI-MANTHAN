# ─────────────────────────────────────────────────────────────────────────────
# AI Manthan 2026 — Backend environment (Supabase PostgreSQL + Prisma)
# Copy to `.env` (prod values) or `.env.local` (local dev overrides) and fill in.
# NEVER commit real secrets — `.env` / `.env.local` are gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Dashboard → Project Settings → API / Database) ────────────────
# Prisma connection strings.
#
# DATABASE_URL — pooled connection (use the Transaction pooler, port 6543).
#   postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pooled=true
# DIRECT_URL  — direct connection (port 5432) for migrations / db push.
#   postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.supabase.com:5432/postgres
DATABASE_URL=
DIRECT_URL=

# Supabase client keys (Dashboard → Settings → API)
#   anon key  — public, RLS-scoped (safe to expose with RLS enabled)
#   service role key — SERVER ONLY, bypasses RLS. Never expose to the client.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Runtime ─────────────────────────────────────────────────────────────────
# development | production (Render/Vercel inject NODE_ENV=production)
NODE_ENV=development

# Render injects PORT; local default stays 4000
# PORT=4000

# Comma-separated allowed browser origins. Supports exact origins and
# single-label wildcards.
#   local dev:  http://localhost:3000
#   production: https://your-app.vercel.app,https://*.vercel.app
CORS_ORIGINS=http://localhost:3000

# ── Admin ───────────────────────────────────────────────────────────────────
# Header auth for /api/admin/* and /api/visits/admin (x-admin-key header).
# Use a long random string in production (e.g. `openssl rand -hex 32`).
ADMIN_KEY=

# ── SMTP (coordinator routing + participant receipts) ───────────────────────
# Unconfigured = emails skipped honestly (queue still stores tickets).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AI Manthan Support <support@aimanthan.in>
