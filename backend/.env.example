# ─────────────────────────────────────────────────────────────────────
# AI Manthan backend — environment configuration
#
# PRODUCTION (Render):
#   Set these in the Render dashboard (Environment → Environment
#   Variables). Never commit real values.
#
# LOCAL DEVELOPMENT:
#   cp .env.example .env.local   (or plain .env)
#   Local defaults match this file — a bare `npm run dev` works with no
#   .env at all when a local MongoDB is running on 27017.
# ─────────────────────────────────────────────────────────────────────

# 'production' on Render; leave unset (or 'development') locally
NODE_ENV=development

# MongoDB Atlas connection string (Production). Get it from Atlas →
# Cluster → Connect → Drivers. URL-encode the password if it contains
# special characters. Example:
#   mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/aimanthan?retryWrites=true&w=majority
# Local dev (optional override): mongodb://127.0.0.1:27017/aimanthan
MONGODB_URI=

# Comma-separated list of allowed browser origins (CORS).
# Production example:
#   https://ai-manthan.vercel.app,https://*.vercel.app
# Local default if unset: http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Admin APIs (queue, coordinators CRUD) — x-admin-key header.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=change-me-long-random-string

# Render injects this automatically — do NOT set it manually there.
# Local default if unset: 4000
# PORT=4000

# Coordinator email dispatch (SMTP) — leave empty to log-only mode.
# Gmail: use an App Password (2FA required), host smtp.gmail.com:587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AI Manthan Support <support@aimanthan.in>
