# Next.js frontend configuration — copy to .env.local and adjust
# Site URL used for canonical, sitemap, robots and OG URLs (REQUIRED in prod)
NEXT_PUBLIC_SITE_URL=https://your-real-domain.com
# GA4 measurement id — leave unset to disable analytics entirely
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Supabase — THE ONLY backend (100% Supabase, no REST API needed) ──────
# Project ROOT URL (no /rest/v1/ suffix — supabase-js appends its own paths;
# auth/realtime/rpc break if the suffix is present)
NEXT_PUBLIC_SUPABASE_URL=https://hnrkovgqbmqykiozazqj.supabase.com
# anon/public key — safe for the browser (RLS-guarded; see supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhucmtvdmdxYm1xeWtpb3phenFqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk4MzgxNDAsImV4cCI6MjEwNTQxNDE0MH0.H_m9EX95wwxPfFAX3M7bc84v2pNsHlz4ayKJ5OaSlrY
